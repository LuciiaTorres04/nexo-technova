# Copia este archivo como .env y rellena tu clave.
# .env NO se sube a GitHub (está en .gitignore); este .env.example sí, sin la clave.

LLM_API_KEY=pon-aqui-tu-clave

# Opcional. Por defecto: OpenAI con gpt-4o-mini.
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini

# Alternativa gratuita con Groq (crea la clave en console.groq.com):
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low

# Alternativa sin internet ni clave, con Ollama instalado en tu PC:
# LLM_API_KEY=ollama
# LLM_API_URL=http://localhost:11434/v1/chat/completions
# LLM_MODEL=llama3.2
